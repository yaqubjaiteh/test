# Copy this file to ".env" and fill in your own values.
# Restart the server (npm start) after changing anything here.

# ---- General ----
PORT=3000
# The public address of your website. Payment companies send customers back here after paying.
BASE_URL=http://localhost:3000
ADMIN_PASSWORD=change-me-to-something-strong
RESTAURANT_NAME=The Golden Spoon

# ---- Money ----
# Symbol shown on the website
CURRENCY=$
# Three-letter currency code used for online payments (e.g. USD, EUR, GBP, GMD, NGN, GHS, KES)
PAYMENT_CURRENCY=USD

# ---- Online payments ----
# test        = practice payment page, no real money (default)
# stripe      = cards via Stripe           -> needs STRIPE_SECRET_KEY
# flutterwave = cards + mobile money       -> needs FLUTTERWAVE_SECRET_KEY
PAYMENT_PROVIDER=test
STRIPE_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# ---- Email (SMTP) ----
# Leave SMTP_HOST empty to save emails to data/outbox instead of sending them.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#                SMTP_PASS=<a Gmail "app password", not your normal password>
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional: the restaurant also receives a copy of every order confirmation
RESTAURANT_EMAIL=
